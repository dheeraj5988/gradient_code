# Copy to .env.local and fill in. Without these the site runs on built-in demo data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name also supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Payments: keys are normally entered in Admin → Payments (stored encrypted). Optional env fallback:
# PAYMENT_SETTINGS_KEY=
# PAYPUR_KEY=
# PAYPUR_SALT=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_API_KEY=
# Testing only — override Google endpoints (leave unset in production)
# GOOGLE_DRIVE_API_BASE=
# GOOGLE_OAUTH_TOKEN_URL=
